REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Calendar push (set these in Vercel project env vars, not here —
# this file is just a reference for what's needed).
# Reuses the same OAuth client as the project-manager repo's calendar
# integration IF that refresh token was granted "calendar" or
# "calendar.events" scope (write access) — the project-manager one only
# reads, so double check before reusing the same refresh token here.
# To find the calendar ID: Google Calendar > Settings > click the
# "JW/Ministry" calendar > Integrate calendar > Calendar ID.
GCAL_CLIENT_ID=your_google_oauth_client_id
GCAL_CLIENT_SECRET=your_google_oauth_client_secret
GCAL_REFRESH_TOKEN=your_google_oauth_refresh_token
GCAL_STUDY_CALENDAR_ID=your_jw_ministry_calendar_id
