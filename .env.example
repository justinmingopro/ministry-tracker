REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# iCloud calendar push (set these in Vercel project env vars, not here —
# this file is just a reference for what's needed). The "JW/Ministry"
# calendar lives on Apple/iCloud, not Google, so this uses CalDAV
# (via the tsdav library) instead of the Google Calendar API used by
# the sibling project-manager repo.
#
# ICLOUD_APP_SPECIFIC_PASSWORD must be an app-specific password, NOT your
# real Apple ID password — generate one at appleid.apple.com under
# Sign-In and Security > App-Specific Passwords. Revocable anytime.
#
# ICLOUD_STUDY_CALENDAR_NAME must exactly match the calendar's display
# name in Calendar app / iCloud (defaults to "JW/Ministry" if unset).
ICLOUD_APPLE_ID=your_apple_id_email
ICLOUD_APP_SPECIFIC_PASSWORD=your_app_specific_password
ICLOUD_STUDY_CALENDAR_NAME=JW/Ministry

# Bear notes import (set in Vercel project env vars, not here). Optional but
# recommended: if set, the iOS Shortcut that imports Bear notes must send this
# as "Authorization: Bearer <token>", otherwise /api/bear-import accepts
# unauthenticated requests from anyone who finds the URL. See README.md for
# how to build the Shortcut.
BEAR_IMPORT_TOKEN=a_random_secret_string
